# ─── Database ────────────────────────────────────────────────
# Neon Postgres connection string (with sslmode=require)
DATABASE_URL=

# ─── NextAuth ────────────────────────────────────────────────
# Random 32+ char secret (openssl rand -base64 32)
AUTH_SECRET=
# Production URL, e.g. https://www.veretennikov.info
AUTH_URL=

# ─── Resend (magic link + brief notifications) ───────────────
# https://resend.com/api-keys
AUTH_RESEND_KEY=
# Verified sender address (until domain verified, use onboarding@resend.dev)
EMAIL_FROM="Veretennikov Studio <onboarding@resend.dev>"

# ─── Telegram brief notifications ────────────────────────────
# 1. Create bot via @BotFather, save the token here
# 2. Send any message to the bot, then GET
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    to find your chat.id
# If both vars are empty, Telegram notifications are silently skipped
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Cloudflare R2 (poster uploads) ──────────────────────────
# Setup:
#   1. Cloudflare dashboard → R2 → создать bucket (например veretennikov-media)
#   2. R2 → Manage R2 API Tokens → Create API Token (Object Read & Write)
#   3. Settings бакета → Public Access → Connect a custom domain
#      (рекомендуется, например media.veretennikov.info), либо включить r2.dev
#   4. Account ID — копируется из верхнего правого угла Cloudflare dashboard
#   5. После настройки добавь свой R2 публичный домен в next.config.ts → images.remotePatterns
# Если переменные не заданы — file upload в админке отключается, остаётся только ручной URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ─── Бриф «Карандаш» (/karandash-brief) ──────────────────────
# ВЫДЕЛЕННЫЕ переменные — НЕ переиспользуют TELEGRAM_BOT_TOKEN/CHAT_ID,
# т.к. те заняты штатным брифингом студии (@VeretennikovBriefBot).
# Отдельный бот брифа «Карандаш»: @roma_karandash_bot.
#
# Код доступа к странице (если пусто — гейт отключён, страница открыта).
KARANDASH_BRIEF_ACCESS_CODE=
# Необязательно: отдельный секрет для подписи cookie доступа.
KARANDASH_BRIEF_COOKIE_SECRET=
# Токен бота @roma_karandash_bot от @BotFather (только сервер, не в Git/бандл).
KARANDASH_BRIEF_BOT_TOKEN=
# Chat ID получателя брифа (напишите боту, затем /getUpdates → chat.id).
KARANDASH_BRIEF_CHAT_ID=

# ─── Превью мастер-класса 4П для Уральской ТПП ───────────────
# /presentation/ural-tpp-4p-x7q2md
# Код доступа к превью. Если переменная НЕ задана — страница открывается
# по прямой ссылке (индексация всё равно закрыта: X-Robots-Tag в
# next.config.ts, метатег в layout, Disallow в robots.ts, нет в sitemap).
# Если задана — включается парольный вход с httpOnly-cookie на 30 дней.
# Включение/отключение не требует пересборки: правка .env.production +
# `pm2 reload studio --update-env`.
UTPP_MC_PASSWORD=
