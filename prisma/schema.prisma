generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CaseType {
  VIDEO
  AI
  SYNTHESIS
  DEV
  GAME
}

enum BriefType {
  VIDEO
  AI
  UNSURE
}

enum BriefStatus {
  NEW
  CONTACTED
  IN_DISCUSSION
  CONVERTED
  ARCHIVED
}

model Case {
  id          String   @id @default(cuid())
  slug        String   @unique
  client      String
  title       String
  description String
  type        CaseType
  year        Int
  services    String[]
  challenge   String?
  solution    String?
  outcome     String?
  videoId     String?
  posterUrl   String?
  duration    Int?
  isPublic    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

// ──────────────────────────────────────────────────────────────────
// Auth.js v5 — Prisma adapter models
// ──────────────────────────────────────────────────────────────────

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  emailVerified  DateTime?
  name           String?
  image          String?
  sessions       Session[]
  accounts       Account[]
  authenticators Authenticator[]
  createdAt      DateTime        @default(now())
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ──────────────────────────────────────────────────────────────────
// Briefs — incoming project requests via /brief form
// ──────────────────────────────────────────────────────────────────

model Brief {
  id             String      @id @default(cuid())
  type           BriefType
  status         BriefStatus @default(NEW)

  // Project (conditional fields, all optional)
  format         String?
  projectTitle   String?
  mainIdea       String?
  audience       String?
  showWhere      String?
  duration       String?
  hasMaterials   String?
  currentProcess String?
  scale          String?
  integrations   String?
  successMetric  String?

  // Company
  company        String?
  industry       String?
  website        String?
  trigger        String?

  // Constraints
  deadline       String?
  budget         String?
  ndaNeeded      Boolean     @default(false)

  // References
  references     String?
  antiReferences String?
  attachments    String?

  // Contact (name + email required at minimum)
  name           String
  position       String?
  email          String
  phone          String?
  telegram       String?
  bestTime       String?

  // Admin
  adminNotes     String?

  // 152-ФЗ: версия документа «Согласие на обработку ПДн», с которой согласился
  // субъект, и серверное время получения согласия. Заполняются при отправке
  // формы; ничего сверх этого (IP, user-agent) намеренно не собираем.
  consentVersion String?
  consentAt      DateTime?

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

// Анкета закрытой презентации маскота «Соболёк» (/presentation/sobolek-concept-*).
// Ответы дублируются сюда ДО отправки в Telegram, чтобы ни одна отправка
// не потерялась при сбое доставки. answers — санитизированный JSON строго
// по схеме анкеты (src/lib/sobolek/questions.ts).
model SobolekBrief {
  id             String   @id @default(cuid())
  answers        Json
  schemaVersion  Int
  // 152-ФЗ: версия «Согласия на обработку ПДн» и серверное время согласия
  consentVersion String?
  consentAt      DateTime?
  // Дошла ли копия в Telegram (для контроля канала доставки)
  tgDelivered    Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ──────────────────────────────────────────────────────────────────
// Blog — articles ("Журнал"), managed via /admin/posts
// ──────────────────────────────────────────────────────────────────

model Post {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String?
  body        String    // markdown source
  coverUrl    String?
  tags        String[]
  author      String?
  isPublic    Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isPublic, publishedAt])
}

// ──────────────────────────────────────────────────────────────────
// Lead — короткие входящие обращения: /razbor и /contact
//
// Отдельно от Brief намеренно. Brief — подробная анкета производства
// для уже квалифицированного клиента. Lead — первый безопасный контакт:
// три поля, никаких обязательств. Смешивать их в одной таблице значит
// смешивать две разные стадии воронки.
// ──────────────────────────────────────────────────────────────────

enum LeadSource {
  RAZBOR
  CONTACT
}

enum LeadStatus {
  NEW
  CONTACTED
  SCHEDULED
  CONVERTED
  ARCHIVED
}

model Lead {
  id        String     @id @default(cuid())
  source    LeadSource
  status    LeadStatus @default(NEW)

  name      String
  contact   String     // телефон, Telegram или email — как оставил человек
  process   String?    // «какой процесс разбираем» / текст обращения
  slot      String?    // выбранное окно для звонка (значение из закрытого списка)
  page      String?    // с какой страницы пришёл — метка источника, не ПДн

  // Атрибуция первого касания. Не ПДн: метки ставим мы сами,
  // referer обрезан до origin и пути. Нужны, чтобы понимать,
  // какой канал приводит обращения.
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?
  landing     String?
  referer     String?

  adminNotes String?

  // 152-ФЗ: версия «Согласия на обработку ПДн» и серверное время согласия
  consentVersion String?
  consentAt      DateTime?

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status, createdAt])
}

// ──────────────────────────────────────────────────────────────────
// УТПП — уточнения с закрытой проектной страницы /utpp
// ──────────────────────────────────────────────────────────────────

/// Одна отправка ответов с закрытой страницы пяти инициатив.
///
/// Ролей и персональных приглашений нет: страницу открывают по общему коду
/// доступа, набор вопросов один. Каждая отправка — отдельная запись, поэтому
/// несколько человек могут ответить независимо и ничего не перезапишут.
///
/// Сознательно НЕ сохраняются: IP, User-Agent, время чтения, поведение на
/// странице и любой отпечаток браузера.
model UtppProjectResponse {
  id                 String   @id @default(cuid())
  /// Необязательное поле «Кто отвечал». Может быть пустым.
  respondentName     String?
  /// Ответы после серверной пересборки: { [questionId]: Answer }.
  answers            Json
  /// Сколько вопросов реально отвечено — чтобы не считать при каждом чтении.
  answeredCount      Int      @default(0)
  /// Версия текста страницы на момент ответа.
  contentVersion     String
  /// Версия набора вопросов на момент ответа.
  questionSetVersion String
  submittedAt        DateTime @default(now())

  @@index([submittedAt])
}
